*.exe
*.pdb
*.obj
*.ilk
*.exp
*.recipe
*.tlog
*.lastbuildstate
*.log
/x64/**/*.lib
/x86/**/*.lib
/Debug/*.lib
/Release/*.lib
!dependencies/**/*.lib

# --- Specific GLAD/Internal Cache ---
.cache/

# --- OS Specific ---
.DS_Store
Thumbs.db

# --- Asset Backups (Optional) ---
*.bak
*.tmp